###############################################################
# Dracula for broot
# https://draculatheme.com/broot
#
# Uses RGB values, so it needs a true-color terminal.
# Doc at https://dystroy.org/broot/skins/
###############################################################

skin: {
    default: rgb(248, 248, 242) None / rgb(248, 248, 242) None
    tree: rgb(98, 114, 164) None / rgb(68, 71, 90) None
    parent: rgb(248, 248, 242) None / rgb(248, 248, 242) None Italic
    file: rgb(248, 248, 242) None / rgb(248, 248, 242) None Italic
    directory: rgb(189, 147, 249) None Bold / rgb(189, 147, 249) None
    exe: rgb(80, 250, 123) None
    link: rgb(139, 233, 253) None Italic
    pruning: rgb(98, 114, 164) None Italic

    # permissions
    perm__: rgb(98, 114, 164) None
    perm_r: rgb(241, 250, 140) None
    perm_w: rgb(255, 85, 85) None
    perm_x: rgb(80, 250, 123) None
    owner: rgb(139, 233, 253) None Bold
    group: rgb(139, 233, 253) None

    count: rgb(98, 114, 164) None
    dates: rgb(98, 114, 164) None
    sparse: rgb(255, 184, 108) None

    content_extract: rgb(98, 114, 164) None Italic
    content_match: rgb(241, 250, 140) None Bold

    # git
    git_branch: rgb(255, 121, 198) None
    git_insertions: rgb(80, 250, 123) None
    git_deletions: rgb(255, 85, 85) None
    git_status_current: rgb(98, 114, 164) None
    git_status_modified: rgb(255, 184, 108) None
    git_status_staged: rgb(80, 250, 123) None
    git_status_new: rgb(139, 233, 253) None Bold
    git_status_ignored: rgb(98, 114, 164) None
    git_status_conflicted: rgb(255, 85, 85) None Bold
    git_status_other: rgb(255, 121, 198) None

    # highlighting
    selected_line: None rgb(68, 71, 90) / None rgb(52, 55, 70)
    char_match: rgb(80, 250, 123) None Bold
    file_error: rgb(255, 85, 85) None

    flag_label: rgb(98, 114, 164) None
    flag_value: rgb(255, 121, 198) None Bold

    input: rgb(248, 248, 242) rgb(33, 34, 44) / rgb(248, 248, 242) rgb(33, 34, 44) Italic

    # status bar
    status_error: rgb(248, 248, 242) rgb(255, 85, 85)
    status_job: rgb(40, 42, 54) rgb(255, 184, 108)
    status_normal: rgb(248, 248, 242) rgb(33, 34, 44) / None None
    status_italic: rgb(189, 147, 249) rgb(33, 34, 44) Italic / None None
    status_bold: rgb(255, 121, 198) rgb(33, 34, 44) Bold / None None
    status_code: rgb(80, 250, 123) rgb(33, 34, 44) / None None
    status_ellipsis: rgb(248, 248, 242) rgb(33, 34, 44) Bold / None None

    purpose_normal: None None
    purpose_italic: rgb(189, 147, 249) None Italic
    purpose_bold: rgb(255, 121, 198) None Bold
    purpose_ellipsis: None None

    # scrollbar
    scrollbar_track: rgb(68, 71, 90) None / rgb(33, 34, 44) None
    scrollbar_thumb: rgb(189, 147, 249) None / rgb(98, 114, 164) None

    # documentation
    help_paragraph: None None
    help_bold: rgb(255, 121, 198) None Bold
    help_italic: rgb(189, 147, 249) None Italic
    help_code: rgb(80, 250, 123) rgb(33, 34, 44)
    help_headers: rgb(189, 147, 249) None Bold
    help_table_border: rgb(68, 71, 90) None

    # preview
    preview_title: rgb(248, 248, 242) rgb(33, 34, 44) / rgb(98, 114, 164) rgb(33, 34, 44)
    preview: rgb(248, 248, 242) None / rgb(248, 248, 242) None
    preview_line_number: rgb(98, 114, 164) None / rgb(98, 114, 164) None
    preview_separator: rgb(68, 71, 90) None / rgb(68, 71, 90) None
    preview_match: rgb(40, 42, 54) rgb(241, 250, 140) Bold
    diff_line_number: rgb(98, 114, 164) None
    diff_added: rgb(80, 250, 123) None
    diff_removed: rgb(255, 85, 85) None

    hex_null: rgb(98, 114, 164) None
    hex_ascii_graphic: rgb(248, 248, 242) None
    hex_ascii_whitespace: rgb(255, 184, 108) None
    hex_ascii_other: rgb(139, 233, 253) None
    hex_non_ascii: rgb(255, 121, 198) None

    staging_area_title: rgb(248, 248, 242) rgb(33, 34, 44) / rgb(98, 114, 164) rgb(33, 34, 44)

    mode_command_mark: rgb(40, 42, 54) rgb(255, 121, 198) Bold

    # file system occupation
    good_to_bad_0: rgb(80, 250, 123)
    good_to_bad_1: rgb(80, 250, 123)
    good_to_bad_2: rgb(80, 250, 123)
    good_to_bad_3: rgb(241, 250, 140)
    good_to_bad_4: rgb(241, 250, 140)
    good_to_bad_5: rgb(255, 184, 108)
    good_to_bad_6: rgb(255, 184, 108)
    good_to_bad_7: rgb(255, 121, 198)
    good_to_bad_8: rgb(255, 85, 85)
    good_to_bad_9: rgb(255, 85, 85)
}
